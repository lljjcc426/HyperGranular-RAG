        "$AuditRel = 'docs/STAGE4B_U1_PREGOLD_AMENDMENT_5G_B_1_SYNTHETIC_REBINDING_AUDIT.md'",
        "$ApprovalDecisionRel = 'docs/STAGE4B_U1_PREGOLD_AMENDMENT_5G_B_1_APPROVAL_DECISION.md'",
        "$PythonExe = 'D:\\Users\\cc\\AppData\\Local\\Programs\\Python\\Python312\\python.exe'",
        "function Fail([string]$Message) { throw [System.InvalidOperationException]::new($Message) }",
        "function Get-Sha256([byte[]]$Bytes) {",
        "    $hasher = [System.Security.Cryptography.SHA256]::Create()",
        "    try { return ([System.BitConverter]::ToString($hasher.ComputeHash($Bytes))).Replace('-', '') }",
        "    finally { $hasher.Dispose() }",
        "}",
        "function Get-RepoFile([string]$RelativePath) {",
        "    if ([string]::IsNullOrWhiteSpace($RelativePath) -or [System.IO.Path]::IsPathRooted($RelativePath) -or $RelativePath -match '(^|[\\/])\\.\\.([\\/]|$)') { Fail \"invalid repo-relative path: $RelativePath\" }",
        "    $root = [System.IO.Path]::GetFullPath($RepoRoot).TrimEnd('\\')",
        "    $candidate = [System.IO.Path]::GetFullPath([System.IO.Path]::Combine($root, $RelativePath.Replace('/', '\\'))) ",
        "    if (-not $candidate.StartsWith($root + '\\', [System.StringComparison]::OrdinalIgnoreCase)) { Fail \"path escapes repo: $RelativePath\" }",
        "    if (-not [System.IO.File]::Exists($candidate)) { Fail \"required regular file missing: $RelativePath\" }",
        "    $item = Get-Item -LiteralPath $candidate -Force",
        "    if ($item.PSIsContainer -or (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { Fail \"not a regular non-reparse file: $RelativePath\" }",
        "    $bytes = [System.IO.File]::ReadAllBytes($candidate)",
        "    return [pscustomobject]@{ RelativePath = $RelativePath; FullPath = $candidate; Bytes = $bytes; Length = [int64]$bytes.LongLength; Sha256 = (Get-Sha256 $bytes) }",
        "}",
        "function Get-StrictUtf8([object]$FileInfo) {",
        "    $utf8 = [System.Text.UTF8Encoding]::new($false, $true)",
        "    try { return $utf8.GetString([byte[]]$FileInfo.Bytes) } catch { Fail \"strict UTF-8 decode failed: $($FileInfo.RelativePath)\" }",
        "}",
        "function Invoke-GitLines([string[]]$Arguments) {",
        "    $lines = @(& git -C $RepoRoot @Arguments 2>&1)",
        "    if ($LASTEXITCODE -ne 0) { Fail \"git command failed: $($Arguments -join ' ')\" }",
        "    return @($lines | ForEach-Object { [string]$_ })",
        "}",
        "function Assert-ExactCaseSet([object[]]$Actual, [object[]]$Expected, [string]$Label) {",
        "    $actualNames = @($Actual | ForEach-Object { [string]$_ })",
        "    $expectedNames = @($Expected | ForEach-Object { [string]$_ })",
        "    if ($actualNames.Count -ne $expectedNames.Count) { Fail \"$Label count failed\" }",
        "    $uniqueActual = @($actualNames | Sort-Object -CaseSensitive -Unique)",
        "    $uniqueExpected = @($expectedNames | Sort-Object -CaseSensitive -Unique)",
        "    if ($uniqueActual.Count -ne $actualNames.Count) { Fail \"$Label duplicate actual name\" }",
        "    if ($uniqueExpected.Count -ne $expectedNames.Count) { Fail \"$Label duplicate expected name\" }",
        "    $foldedActual = @($actualNames | ForEach-Object { $_.ToUpperInvariant() } | Sort-Object -CaseSensitive -Unique)",
        "    $foldedExpected = @($expectedNames | ForEach-Object { $_.ToUpperInvariant() } | Sort-Object -CaseSensitive -Unique)",
        "    if ($foldedActual.Count -ne $actualNames.Count) { Fail \"$Label case-only actual collision\" }",
        "    if ($foldedExpected.Count -ne $expectedNames.Count) { Fail \"$Label case-only expected collision\" }",
        "    $delta = @(Compare-Object -ReferenceObject $uniqueExpected -DifferenceObject $uniqueActual -CaseSensitive)",
        "    if ($delta.Count -ne 0) { Fail \"$Label exact case-sensitive set failed\" }",
        "}",
        "function Assert-ExactScalar([object]$Actual, [string]$Type, [object]$Expected, [string]$Label) {",
        "    if ($null -eq $Actual) { Fail \"$Label is null\" }",
        "    if ($Type -ceq 'integer') { if ($Actual.GetType().FullName -cne 'System.Int32' -or [int]$Actual -ne [int]$Expected) { Fail \"$Label integer mismatch\" }; return }",
        "    if ($Type -ceq 'boolean') { if ($Actual.GetType().FullName -cne 'System.Boolean' -or [bool]$Actual -ne [bool]$Expected) { Fail \"$Label boolean mismatch\" }; return }",
        "    Fail \"unknown scalar contract type: $Type\"",
        "}",
        "$manifestFile = Get-RepoFile $ManifestRel",
        "$manifest = ConvertFrom-Json -InputObject (Get-StrictUtf8 $manifestFile)",
        "$frozenSource = [string]::Join(\"`n\", @($manifest.single_real_precommit_validation.frozen_command.source_lines | ForEach-Object { [string]$_ }))",
        "$frozenSourceBytes = [System.Text.UTF8Encoding]::new($false).GetBytes($frozenSource)",
        "if ($frozenSourceBytes.LongLength -ne [int64]$manifest.single_real_precommit_validation.frozen_command.source_bytes) { Fail 'frozen validator source byte count mismatch' }",
        "if ((Get-Sha256 $frozenSourceBytes) -cne [string]$manifest.single_real_precommit_validation.frozen_command.source_sha256) { Fail 'frozen validator source SHA mismatch' }",
        "$headLines = @(Invoke-GitLines -Arguments @('rev-parse', 'HEAD'))",
        "$originLines = @(Invoke-GitLines -Arguments @('rev-parse', 'origin/main'))",
        "$parentLines = @(Invoke-GitLines -Arguments @('rev-parse', 'HEAD^'))",
        "if ($headLines.Count -ne 1 -or $originLines.Count -ne 1 -or $parentLines.Count -ne 1) { Fail 'Git commit derivation cardinality failed' }",
        "$approvalCommit = $headLines[0].Trim()",
        "$originCommit = $originLines[0].Trim()",
        "$packageCommit = $parentLines[0].Trim()",
        "if ($approvalCommit -cnotmatch '^[0-9a-f]{40}$' -or $packageCommit -cnotmatch '^[0-9a-f]{40}$') { Fail 'derived commit syntax failed' }",
        "if ($originCommit -cne $approvalCommit) { Fail 'local HEAD and origin/main differ' }",
        "$approvalChanged = @(Invoke-GitLines -Arguments @('diff-tree', '--root', '--no-commit-id', '--name-only', '-r', $approvalCommit))",
        "Assert-ExactCaseSet $approvalChanged @('AGENTS.md', $ApprovalDecisionRel) 'approval changed paths'",
        "$governanceFile = Get-RepoFile $GovernanceRel",
        "$governanceRaw = Get-StrictUtf8 $governanceFile",
        "$pythonSource = @'",
        "import json, re, sys",
        "def no_duplicates(pairs):",
        "    out = {}",
        "    for key, value in pairs:",
        "        if key in out:",
        "            raise ValueError('duplicate raw JSON key: ' + key)",
        "        out[key] = value",
        "    return out",
        "def reject_constant(value):",
        "    raise ValueError('non-finite JSON constant: ' + value)",
        "try:",
        "    raw = sys.stdin.buffer.read().decode('utf-8', 'strict')",
        "    root = json.loads(raw, object_pairs_hook=no_duplicates, parse_constant=reject_constant)",
        "    if type(root) is not dict:",
        "        raise ValueError('governance root must be object')",
        "    required = {'package_commit', 'approval_commit', 'artifacts_present', 'bound_files', 'synthetic_rebinding'}",
        "    if not required.issubset(root):",
        "        raise ValueError('governance required top-level field missing')",
        "    if type(root['package_commit']) is not str or not re.fullmatch(r'[0-9a-f]{40}', root['package_commit']):",
        "        raise ValueError('invalid package commit')",
        "    if type(root['approval_commit']) is not str or not re.fullmatch(r'[0-9a-f]{40}', root['approval_commit']):",
        "        raise ValueError('invalid approval commit')",
        "    artifacts = root['artifacts_present']",
        "    artifact_names = {'rebinding_evidence', 'governance_binding', 'rebinding_audit'}",
        "    if type(artifacts) is not dict or set(artifacts) != artifact_names or any(type(value) is not bool or value is not True for value in artifacts.values()):",
        "        raise ValueError('artifact-presence strict bool gate failed')",
        "    bound_files = root['bound_files']",
        "    if type(bound_files) is not dict:",
        "        raise ValueError('bound_files must be object')",
        "    folded = {}",
        "    entries = []",
        "    for name, record in bound_files.items():",
        "        folded_name = name.casefold()",
        "        if folded_name in folded and folded[folded_name] != name:",
        "            raise ValueError('case-only raw bound_files key collision')",
        "        folded[folded_name] = name",
        "        if type(record) is not dict or set(record) != {'path', 'bytes', 'sha256'}:",
        "            raise ValueError('bound-file record schema failed: ' + name)",
        "        if type(record['path']) is not str or type(record['bytes']) is not int or isinstance(record['bytes'], bool) or record['bytes'] < 0:",
        "            raise ValueError('bound-file path/bytes type failed: ' + name)",
        "        if type(record['sha256']) is not str or not re.fullmatch(r'[0-9A-F]{64}', record['sha256']):",
        "            raise ValueError('bound-file SHA syntax failed: ' + name)",
        "        entries.append({'name': name, 'path': record['path'], 'bytes': record['bytes'], 'sha256': record['sha256']})",
        "    summary = root['synthetic_rebinding']",
        "    if type(summary) is not dict:",
        "        raise ValueError('synthetic_rebinding must be object')",
        "    report = {'package_commit': root['package_commit'], 'approval_commit': root['approval_commit'], 'bound_file_entries': entries, 'synthetic_rebinding': summary}",
        "    print(json.dumps(report, ensure_ascii=True, sort_keys=True, separators=(',', ':')))",
        "except Exception as exc:",
        "    print('governance raw JSON gate failed: ' + str(exc), file=sys.stderr)",
        "    sys.exit(2)",
        "'@",
        "$savedOutputEncoding = $OutputEncoding",
        "$OutputEncoding = [System.Text.UTF8Encoding]::new($false)",
        "try { $inspectionLines = @($governanceRaw | & $PythonExe -c $pythonSource 2>&1); $pythonExit = $LASTEXITCODE } finally { $OutputEncoding = $savedOutputEncoding }",
        "if ($pythonExit -ne 0) { Fail ([string]::Join(' | ', @($inspectionLines | ForEach-Object { [string]$_ }))) }",
        "$inspection = ConvertFrom-Json -InputObject ([string]::Join(\"`n\", @($inspectionLines | ForEach-Object { [string]$_ })))",
        "if ([string]$inspection.package_commit -cne $packageCommit) { Fail 'governance package commit mismatch' }",
        "if ([string]$inspection.approval_commit -cne $approvalCommit) { Fail 'governance approval commit mismatch' }",
        "$approvalDecisionText = Get-StrictUtf8 (Get-RepoFile $ApprovalDecisionRel)",
        "if (-not $approvalDecisionText.Contains($packageCommit)) { Fail 'approval decision does not bind package commit' }",
        "if (-not $approvalDecisionText.Contains([string]$manifest.single_real_precommit_validation.frozen_command.source_sha256)) { Fail 'approval decision does not bind validator source SHA' }",
        "if (-not $approvalDecisionText.Contains(([string][int64]$manifest.single_real_precommit_validation.frozen_command.source_bytes))) { Fail 'approval decision does not bind validator source bytes' }",
        "$actualNames = @($inspection.bound_file_entries | ForEach-Object { [string]$_.name })",
        "$expectedNames = @($manifest.future_governance_binding_contract.bound_files_required | ForEach-Object { [string]$_ })",
        "Assert-ExactCaseSet $actualNames $expectedNames 'bound file names'",
        "$registry = @($manifest.future_governance_binding_contract.bound_file_path_registry)",
        "$registryNames = @($registry | ForEach-Object { [string]$_.name })",
        "Assert-ExactCaseSet $registryNames $expectedNames 'bound-file path registry names'",
        "foreach ($name in $expectedNames) {",
        "    $actualMatches = @($inspection.bound_file_entries | Where-Object { [string]$_.name -ceq $name })",
        "    $registryMatches = @($registry | Where-Object { [string]$_.name -ceq $name })",
        "    if ($actualMatches.Count -ne 1 -or $registryMatches.Count -ne 1) { Fail \"bound-file lookup cardinality failed: $name\" }",
        "    $actual = $actualMatches[0]",
        "    $registeredPath = [string]$registryMatches[0].path",
        "    if ([string]$actual.path -cne $registeredPath) { Fail \"bound-file path mismatch: $name\" }",
        "    $current = Get-RepoFile $registeredPath",
        "    if ([int64]$actual.bytes -ne $current.Length) { Fail \"bound-file byte count mismatch: $name\" }",
        "    if ([string]$actual.sha256 -cne $current.Sha256) { Fail \"bound-file SHA mismatch: $name\" }",
        "}",
        "$historicalNames = @('historical_5g_b_rebinding_audit', 'historical_5g_b_governance_binding', 'historical_5g_b_synthetic_rebinding_evidence')",
        "$historicalFrozen = @($manifest.preserved_historical_5g_b_artifacts.rebinding_audit, $manifest.preserved_historical_5g_b_artifacts.governance_binding, $manifest.preserved_historical_5g_b_artifacts.synthetic_rebinding_evidence)",
        "for ($i = 0; $i -lt $historicalNames.Count; $i++) {",
        "    $record = @($inspection.bound_file_entries | Where-Object { [string]$_.name -ceq $historicalNames[$i] })[0]",
        "    if ([string]$record.path -cne [string]$historicalFrozen[$i].path -or [int64]$record.bytes -ne [int64]$historicalFrozen[$i].bytes -or [string]$record.sha256 -cne [string]$historicalFrozen[$i].sha256) { Fail \"historical artifact freeze mismatch: $($historicalNames[$i])\" }",
        "}",
        "$evidenceFile = Get-RepoFile $EvidenceRel",
        "$evidence = ConvertFrom-Json -InputObject (Get-StrictUtf8 $evidenceFile)",
        "foreach ($rule in @($manifest.future_governance_binding_contract.fresh_evidence_required_exact_values)) {",
        "    $properties = @($evidence.PSObject.Properties | Where-Object { [string]$_.Name -ceq [string]$rule.name })",
        "    if ($properties.Count -ne 1) { Fail \"fresh evidence field missing or ambiguous: $($rule.name)\" }",
        "    Assert-ExactScalar $properties[0].Value ([string]$rule.type) $rule.value \"fresh evidence $($rule.name)\"",
        "}",
