      "source_lines": [
        "Set-StrictMode -Version Latest",
        "$ErrorActionPreference = 'Stop'",
        "$RepoRoot = 'E:\\科研\\HyperGranular-RAG'",
        "$ManifestRel = 'docs/STAGE4B_U1_PREGOLD_AMENDMENT_5G_B_1_MANIFEST.json'",
