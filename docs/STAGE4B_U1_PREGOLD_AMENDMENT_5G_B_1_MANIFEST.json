        "Assert-ExactScalar $evidence.official_path_access_guard.blocked_or_attempted_access_count 'integer' $guardContract.blocked_or_attempted_access_count 'official guard blocked count'",
        "Assert-ExactScalar $evidence.official_path_access_guard.metadata_or_content_access_attempts 'integer' $guardContract.metadata_or_content_access_attempts 'official guard access count'",
        "Assert-ExactScalar $evidence.official_path_access_guard.installed 'boolean' $guardContract.installed 'official guard installed'",
        "$summary = $inspection.synthetic_rebinding",
        "$summaryRules = @(",
        "    @('complete_runs', 'integer', 2), @('preliminary_complete_runs', 'integer', 0), @('targeted_runs', 'integer', 0), @('repair_or_retry_runs', 'integer', 0),",
        "    @('tests_each_run', 'integer', 246), @('execution_head_tests_each_run', 'integer', 41), @('typed_policy_tests_each_run', 'integer', 44),",
        "    @('failures_each_run', 'integer', 0), @('errors_each_run', 'integer', 0), @('skipped_each_run', 'integer', 0), @('official_access_each_run', 'integer', 0),",
        "    @('typed_helper_official_invocations_each_run', 'integer', 0), @('path_helper_official_invocations_each_run', 'integer', 0), @('execution_head_filesystem_git_or_subprocess_calls_each_run', 'integer', 0),",
        "    @('formal_preflight_invocations_each_run', 'integer', 0), @('authorization_token_uses_each_run', 'integer', 0), @('official_capture_invocations_each_run', 'integer', 0),",
        "    @('evidence_byte_identical', 'boolean', $true), @('run_1_os_temp_snapshot_deleted_after_complete_equality', 'boolean', $true), @('tracked_file_count', 'integer', 33)",
        ")",
        "foreach ($rule in $summaryRules) {",
        "    $properties = @($summary.PSObject.Properties | Where-Object { [string]$_.Name -ceq [string]$rule[0] })",
        "    if ($properties.Count -ne 1) { Fail \"synthetic summary field missing or ambiguous: $($rule[0])\" }",
        "    Assert-ExactScalar $properties[0].Value ([string]$rule[1]) $rule[2] \"synthetic summary $($rule[0])\"",
        "}",
        "if ([int64]$summary.evidence_bytes -ne $evidenceFile.Length -or [string]$summary.evidence_sha256 -cne $evidenceFile.Sha256) { Fail 'fresh evidence summary fingerprint mismatch' }",
        "$freshPaths = @([string]$manifest.fresh_paths.rebinding_audit, [string]$manifest.fresh_paths.governance_binding, [string]$manifest.fresh_paths.synthetic_rebinding_evidence)",
        "Assert-ExactCaseSet $freshPaths @($AuditRel, $GovernanceRel, $EvidenceRel) 'fresh path registry'",
