        "import json, sys",
        "def no_duplicates(pairs):",
        "    out = {}",
        "    for key, value in pairs:",
        "        if key in out:",
        "            raise ValueError('duplicate raw JSON key: ' + key)",
        "        out[key] = value",
        "    return out",
        "def reject_constant(value):",
        "    raise ValueError('non-finite JSON constant: ' + value)",
        "def parse_governance(raw):",
        "    root = json.loads(raw, object_pairs_hook=no_duplicates, parse_constant=reject_constant)",
        "    if type(root) is not dict:",
        "        raise ValueError('governance root must be object')",
        "    bound_files = root.get('bound_files')",
        "    if type(bound_files) is not dict:",
        "        raise ValueError('bound_files must be object')",
        "    folded = {}",
        "    for name in bound_files:",
        "        folded_name = name.casefold()",
        "        if folded_name in folded and folded[folded_name] != name:",
        "            raise ValueError('case-only raw bound_files key collision')",
        "        folded[folded_name] = name",
        "    return root",
        "def expect_rejection(name, raw, expected_fragment):",
        "    try:",
        "        parse_governance(raw)",
        "    except Exception as exc:",
        "        if expected_fragment not in str(exc):",
        "            raise AssertionError(name + ': unexpected error: ' + type(exc).__name__ + ': ' + str(exc))",
        "        return {'name': name, 'passed': True, 'observed_rejection': True}",
        "    raise AssertionError(name + ': invalid fixture was accepted')",
        "duplicate_raw = '{\"bound_files\":{\"a\":{\"path\":\"x\",\"bytes\":1,\"sha256\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"},\"a\":{\"path\":\"y\",\"bytes\":1,\"sha256\":\"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\"}}}'",
        "case_only_raw = '{\"bound_files\":{\"a\":{\"path\":\"x\",\"bytes\":1,\"sha256\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"},\"A\":{\"path\":\"y\",\"bytes\":1,\"sha256\":\"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\"}}}'",
        "results = [",
        "    expect_rejection('raw_json_duplicate_bound_files_key', duplicate_raw, 'duplicate raw JSON key: a'),",
        "    expect_rejection('raw_json_case_only_bound_files_collision', case_only_raw, 'case-only raw bound_files key collision'),",
        "]",
